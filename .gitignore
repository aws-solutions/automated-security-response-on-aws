requirements.txt

# pytest
.coverage

# ignore all folders starting with a . (which are often IDE settings, caches)
.*/

# do not ignore .github (issue/PR templates published to the public repo)
!.github/
!.github/**

# do not ignore team-wide kiro steering docs and agents
!.kiro/
.kiro/*
!.kiro/steering/
!.kiro/steering/*
!.kiro/agents/
!.kiro/agents/*
!.kiro/hooks/
.kiro/hooks/*
!.kiro/hooks/format-markdown-prose.kiro.hook
# .kiro/reviews/ is intentionally ignored (generated output)

# dev deployment config (generated by deployment/dev/init.sh)
deployment/dev/local-config.json

# system
.DS_Store
/.temp_redpencil/
/bom.json
aws-exports.json
dynamodb-local-metadata.json

# CSE security scanner artifacts (auto-added by cse init)
.security-scan/
