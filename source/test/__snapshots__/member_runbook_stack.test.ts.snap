                {
                  "Name": "LoggingBucketName",
                  "Selector": "$.Payload.logging_bucket",
                  "Type": "String",
                },
                {
                  "Name": "ResourceArn",
                  "Selector": "$.Payload.ResourceArn",
                  "Type": "String",
