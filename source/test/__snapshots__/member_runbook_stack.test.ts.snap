              "allowedPattern": "^arn:(?:aws|aws-cn|aws-us-gov):secretsmanager:(?:[a-z]{2}(?:-gov)?-[a-z]+-\\d):\\d{12}:secret:([A-Za-z0-9\\/_+=.@-]+)$",
              "description": "(Required) The ARN of the Secrets Manager secret.",
              "type": "String",
            },
          },
