        sns.set_topic_attributes(
            TopicArn=topic_arn,
            AttributeName="Policy",
            AttributeValue=json.dumps(topic_policy),
        )
    except Exception as e:
        exit(f"ERROR: Failed to SetTopicAttributes for {topic_arn}: {str(e)}")",
