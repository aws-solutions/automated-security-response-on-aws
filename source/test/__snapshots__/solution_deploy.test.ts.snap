    "ApiControlStateChangeAlarmBBC89AE4": {
      "Condition": "apiRateLimitAlarmsEnabled",
      "Metadata": {
        "guard": {
          "SuppressedRules": [
            "CFN_NO_EXPLICIT_RESOURCE_NAMES",
