              {
                "Ref": "SynchronizationFindingsConstructSyncMaxAttemptsPerAccount7CF7E97B",
              },
              "},"Next":"SyncAccountsSequentially"},"SyncAccountsSequentially":{"Type":"Map","Comment":"Sync each member account one at a time to stay under the Security Hub GetFindings rate limit","Next":"MarkSweepDone","ItemsPath":"$.accountIds","ItemSelector":{"accountId.$":"$$.Map.Item.Value","attemptsRemaining.$":"$.maxAttempts"},"ItemProcessor":{"ProcessorConfig":{"Mode":"INLINE"},"StartAt":"RunAccountSlice","States":{"RunAccountSlice":{"Next":"DecrementAttempts","Retry":[{"ErrorEquals":["Lambda.ClientExecutionTimeoutException","Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"],"IntervalSeconds":2,"MaxAttempts":6,"BackoffRate":2}],"Catch":[{"ErrorEquals":["States.ALL"],"Next":"AccountSliceTolerated"}],"Type":"Task","ResultPath":"$.slice","Resource":"",
              {
                "Fn::GetAtt": [
                  "SynchronizationFindingsConstructSynchronizationFindingsLambda0E312918",
                  "Arn",
                ],
              },
              "","Parameters":{"task":"sync-account-slice","accountId.$":"$.accountId"}},"AccountDone?":{"Type":"Choice","Choices":[{"Variable":"$.slice.done","BooleanEquals":true,"Next":"AccountSliceComplete"},{"Variable":"$.attemptsRemaining","NumericLessThanEquals":0,"Next":"AccountSliceExhausted"},{"Variable":"$.slice.madeProgress","BooleanEquals":true,"Next":"RunAccountSlice"}],"Default":"AccountSliceTolerated"},"DecrementAttempts":{"Type":"Pass","Parameters":{"accountId.$":"$.accountId","attemptsRemaining.$":"States.MathAdd($.attemptsRemaining, -1)","slice.$":"$.slice"},"Next":"AccountDone?"},"AccountSliceTolerated":{"Type":"Pass","End":true},"AccountSliceComplete":{"Type":"Pass","End":true},"AccountSliceExhausted":{"Type":"Pass","End":true}}},"MaxConcurrency":1},"MarkSweepDone":{"End":true,"Retry":[{"ErrorEquals":["Lambda.ClientExecutionTimeoutException","Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"],"IntervalSeconds":2,"MaxAttempts":6,"BackoffRate":2}],"Type":"Task","Resource":"",
              {
                "Fn::GetAtt": [
