  "overridesJustification": {
    "babel-plugin-istanbul": "CVE-2026-14257 (brace-expansion DoS, GHSA-mh99-v99m-4gvg). @jest/transform pins babel-plugin-istanbul ^7.0.1, whose test-exclude 6.x resolves glob 7 -> minimatch 3 -> brace-expansion 1.1.16. The 1.x line has no patched release, and jest is already at its latest version, so no parent bump resolves this. babel-plugin-istanbul 8 pairs with test-exclude 7, which resolves a patched brace-expansion. Remove this override once @jest/transform depends on babel-plugin-istanbul ^8."
  },
  "overrides": {
    "babel-plugin-istanbul": "^8.0.0"
  }
}
