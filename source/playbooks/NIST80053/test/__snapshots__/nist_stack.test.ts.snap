        if not self.valid_finding:
            return
        pa_pattern = r"^arn:(?:aws|aws-cn|aws-us-gov):securityhub:[a-z]{2}(?:-gov)?-[a-z]+-\\d::(?:product|productv2)/aws/securityhub$"
        if re.match(pa_pattern, self.product_arn or ""):
